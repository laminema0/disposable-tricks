{
  "name": "disposable-tricks",
  "version": "1.0.0",
  "description": "A dark little mobile web game you change by writing to it. Designed and directed by Amin Ranjbar.",
  "author": "Amin Ranjbar",
  "homepage": "https://disposable-tricks.pages.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/laminema0/disposable-tricks.git"
  },
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:providers": "vitest run --config server/vitest.providers.config.ts",
    "preview:host": "npm run build && wrangler pages dev --port 8788",
    "deploy": "npm run build && wrangler pages deploy --branch main --commit-dirty=true"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.2"
  }
}
